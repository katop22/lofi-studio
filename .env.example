# =============================================================================
# lofi-studio — environment configuration sample
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real credentials.
#   cp .env.example .env
# The ".env" file is git-ignored and must NEVER be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Suno AI (music generation)
# -----------------------------------------------------------------------------
# API key (Bearer token). Get it from your Suno API provider dashboard.
SUNO_API_KEY=your_suno_api_key_here

# Base URL of the Suno API provider.
# Default targets sunoapi.org. For kie.ai use: https://api.kie.ai
SUNO_API_BASE_URL=https://api.sunoapi.org

# Model to use. Options (provider-dependent): V3_5, V4, V4_5, V4_5PLUS, V5
SUNO_MODEL=V4_5

# Generate instrumental-only tracks (recommended for lo-fi study beats): true | false
SUNO_INSTRUMENTAL=true

# Custom mode (true lets you control style/title/lyrics precisely). Usually false.
SUNO_CUSTOM_MODE=false

# Optional public callback URL. The polling flow works without it; leave blank
# unless your provider strictly requires one.
SUNO_CALLBACK_URL=

# Polling configuration (the API is asynchronous; we poll until SUCCESS).
SUNO_POLL_INTERVAL_MS=8000
SUNO_POLL_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# Airtable (storage)
# -----------------------------------------------------------------------------
# Personal Access Token (starts with "pat..."). Needs data.records:write scope.
AIRTABLE_API_KEY=your_airtable_pat_here

# Base ID (starts with "app..."). Found in the Airtable API docs for your base.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table name (or table ID) where track records are stored.
AIRTABLE_TABLE_NAME=Tracks

# When true, attach the audio file URL as a real Airtable attachment as well
# as storing the plain URL text. Set to false if your table has no attachment field.
AIRTABLE_ATTACH_AUDIO=true

# -----------------------------------------------------------------------------
# Local output
# -----------------------------------------------------------------------------
# Download the generated audio binary to this folder in addition to storing URLs.
DOWNLOAD_AUDIO=true
OUTPUT_DIR=./output

# Default prompt used when none is passed on the command line.
DEFAULT_PROMPT=Chilled Lo-Fi Beats for studying

# -----------------------------------------------------------------------------
# Phase 2 — artwork & video
# -----------------------------------------------------------------------------
# Artwork source: suno-cover (reuse Suno's cover art) | local-sd (ComfyUI, hi-res)
ARTWORK_SOURCE=suno-cover
ARTWORK_DIR=./output/artwork
VIDEO_AUDIO_DIR=./output/audio
VIDEO_OUTPUT_DIR=./output/video

# Output resolution / frame rate (YouTube standard 1080p).
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# Ken Burns slow-zoom effect. true = subtle motion, false = static image.
VIDEO_KEN_BURNS=true
VIDEO_ZOOM_MAX=1.12

# Encoder quality: lower CRF = higher quality/larger file (18-23 typical).
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_AUDIO_BITRATE=192k

# -----------------------------------------------------------------------------
# Phase 2.5 — local Stable Diffusion artwork (ComfyUI) + Ollama prompts
# Set ARTWORK_SOURCE=local-sd above to enable.
# -----------------------------------------------------------------------------
# Image-prompt generation: ollama (local LLM translates the music vibe) | template
PROMPT_MODE=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=dolphin-llama3:latest
OLLAMA_TIMEOUT_MS=60000

# ComfyUI server (headless API) and SDXL render settings.
COMFYUI_URL=http://127.0.0.1:8188
SD_CHECKPOINT=animagine-xl-4.0.safetensors
SD_BASE_WIDTH=1344
SD_BASE_HEIGHT=768
SD_WIDTH=1920
SD_HEIGHT=1080
SD_STEPS=28
SD_HIRES_STEPS=14
SD_CFG=6
SD_SAMPLER=euler_ancestral
SD_SCHEDULER=normal
SD_HIRES_DENOISE=0.45
SD_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Phase 3 — multi-SNS distribution
# -----------------------------------------------------------------------------
# Allowlist of channels to post to (comma list). If set, it acts as the enable
# switch and overrides the per-channel *_ENABLE flags below.
# Leave blank to use the per-channel ENABLE flags instead.
#   examples:  SNS_CHANNELS=mock        SNS_CHANNELS=youtube,x
SNS_CHANNELS=

# X link posts cost ~$0.20 each (2026 pay-per-use) -> keep links off for X.
SNS_X_INCLUDE_LINK=false
# Other text channels (Threads/Reddit/Pinterest) include the canonical link.
SNS_TEXT_INCLUDE_LINK=true
# Canonical link used by text channels before any video channel has posted.
SNS_FALLBACK_URL=

# --- YouTube (Data API v3, OAuth2) -------------------------------------------
# 1) Put CLIENT_ID + CLIENT_SECRET here (from Google Cloud Desktop OAuth client)
# 2) Run `npm run auth:youtube` once -> it fills YOUTUBE_REFRESH_TOKEN for you
YOUTUBE_ENABLE=false
YOUTUBE_SHORTS_ENABLE=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Upload visibility: unlisted (safe default) | public | private
YOUTUBE_PRIVACY=unlisted

# --- Instagram Reels (Graph API, Business/Creator account) -------------------
INSTAGRAM_ENABLE=false
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- X / Twitter (API v2, OAuth 1.0a user context) ---------------------------
X_ENABLE=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- TikTok (Content Posting API, OAuth; app audit required) -----------------
TIKTOK_ENABLE=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Threads (Threads API, Meta OAuth) ---------------------------------------
THREADS_ENABLE=false
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Reddit (OAuth script app) -----------------------------------------------
REDDIT_ENABLE=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=

# --- Pinterest (API v5, OAuth; app approval required) ------------------------
PINTEREST_ENABLE=false
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Mock test channel (no credentials; for verifying the pipeline) ----------
MOCK_ENABLE=false
